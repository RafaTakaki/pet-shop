@{
    ViewData["Title"] = "Pets";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2>Pets</h2>
    <a href="/Pets/Create" class="btn btn-primary">Novo Pet</a>
</div>

<table class="table table-striped table-hover">
    <thead>
        <tr>
            <th>Nome</th>
            <th>Raça</th>
            <th>Porte</th>
            <th>Ações</th>
        </tr>
    </thead>

    <tbody>
        <tr>
            <td>Rex</td>
            <td>Labrador</td>
            <td>Grande</td>
            <td>
                <a href="/Pets/Edit/1" class="btn btn-warning btn-sm">Editar</a>
                <a href="/Pets/Delete/1" class="btn btn-danger btn-sm">Excluir</a>
            </td>
        </tr>
    </tbody>
</table>