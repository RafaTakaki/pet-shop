@model List<PetShop.Web.Models.Pet>

@{
    ViewData["Title"] = "Pets";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2>Pets</h2>

    @if (Context.Session.GetString("Role") != "Admin")
    {
        <a href="/Pets/Create" class="btn btn-primary">
            Novo Pet
        </a>
    }
</div>

<table class="table table-hover">

    <thead>
        <tr>
            <th>Nome</th>
            <th>Espécie</th>
            <th>Raça</th>
            <th>Idade</th>
            <th>Ações</th>
        </tr>
    </thead>

    <tbody>

        @foreach (var pet in Model)
        {
            <tr>
                <td>@pet.Nome</td>
                <td>@pet.Especie</td>
                <td>@pet.Raca</td>
                <td>@pet.Idade</td>

                <td>
                    <a href="/Pets/Edit/@pet.Id"
                       class="btn btn-warning btn-sm">
                        Editar
                    </a>

                    <a href="/Pets/Delete/@pet.Id"
                       class="btn btn-danger btn-sm">
                        Excluir
                    </a>
                </td>
            </tr>
        }

    </tbody>

</table>