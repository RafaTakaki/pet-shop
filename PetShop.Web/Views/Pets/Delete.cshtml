@model PetShop.Web.Models.Pet

@{
    ViewData["Title"] = "Excluir Pet";
}

<h2 class="mb-4 text-danger">Excluir Pet</h2>

<div class="alert alert-warning">
    Deseja realmente excluir o pet <strong>@Model.Nome</strong>?
</div>

<form method="post" action="/Pets/ConfirmDelete/@Model.Id">

    <button type="submit" class="btn btn-danger">
        Confirmar Exclusão
    </button>

    <a href="/Pets" class="btn btn-secondary">
        Cancelar
    </a>

</form>