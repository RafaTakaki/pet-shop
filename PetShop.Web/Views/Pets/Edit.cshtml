@{
    ViewData["Title"] = "Editar Pet";
}

<h2 class="mb-4">Editar Pet</h2>

<form>

    <div class="mb-3">
        <label class="form-label">Nome</label>
        <input class="form-control" value="Rex" />
    </div>

    <div class="mb-3">
        <label class="form-label">Raça</label>
        <input class="form-control" value="Labrador" />
    </div>

    <button class="btn btn-primary">Atualizar</button>

</form> 