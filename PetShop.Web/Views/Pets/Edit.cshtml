@model PetShop.Web.Models.Pet

@{
    ViewData["Title"] = "Editar Pet";
}

<h2 class="mb-4">Editar Pet</h2>

<form method="post">

    <input asp-for="Id" type="hidden" />

    <div class="mb-3">
        <label class="form-label">Nome</label>
        <input asp-for="Nome" class="form-control" />
    </div>

    <div class="mb-3">
        <label class="form-label">Espécie</label>
        <input asp-for="Especie" class="form-control" />
    </div>

    <div class="mb-3">
        <label class="form-label">Raça</label>
        <input asp-for="Raca" class="form-control" />
    </div>

    <div class="mb-3">
        <label class="form-label">Idade</label>
        <input asp-for="Idade" class="form-control" type="number" />
    </div>

    <button type="submit" class="btn btn-primary">
        Atualizar
    </button>

</form>