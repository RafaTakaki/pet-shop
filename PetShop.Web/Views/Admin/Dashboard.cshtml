@{
    ViewData["Title"] = "Dashboard";
}

<h2 class="mb-4">Dashboard Administrativo</h2>

<div class="row">

    <div class="col-md-4 mb-4">
        <div class="card bg-primary text-white shadow">
            <div class="card-body">
                <h5>Total de Pets</h5>
                <h2>32</h2>
            </div>
        </div>
    </div>

    <div class="col-md-4 mb-4">
        <div class="card bg-success text-white shadow">
            <div class="card-body">
                <h5>Agendamentos Hoje</h5>
                <h2>18</h2>
            </div>
        </div>
    </div>

    <div class="col-md-4 mb-4">
        <div class="card bg-warning text-dark shadow">
            <div class="card-body">
                <h5>Serviços Ativos</h5>
                <h2>6</h2>
            </div>
        </div>
    </div>

</div>

<div class="row mt-4">

    <div class="col-md-4 mb-3">
        <a href="/Pets" class="btn btn-primary w-100 p-3">
            Gerenciar Pets
        </a>
    </div>

    <div class="col-md-4 mb-3">
        <a href="/Services" class="btn btn-success w-100 p-3">
            Gerenciar Serviços
        </a>
    </div>

    <div class="col-md-4 mb-3">
        <a href="/Schedule" class="btn btn-warning w-100 p-3">
            Gerenciar Agenda
        </a>
    </div>

</div>