@model PetShop.Web.Models.Servico

@{
    ViewData["Title"] = "Excluir Serviço";
}

<h2 class="mb-4 text-danger">Excluir Serviço</h2>

<div class="alert alert-warning">
    Deseja realmente excluir o serviço <strong>@Model.Nome</strong>?
</div>

<form method="post" action="/Services/ConfirmDelete/@Model.Id">

    <button type="submit" class="btn btn-danger">
        Confirmar Exclusão
    </button>

    <a href="/Services" class="btn btn-secondary">
        Cancelar
    </a>

</form>