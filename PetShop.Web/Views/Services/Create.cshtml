@model PetShop.Web.Models.Servico

@{
    ViewData["Title"] = "Novo Serviço";
}

<h2 class="mb-4">Cadastrar Serviço</h2>

<form method="post">

    <div class="mb-3">
        <label class="form-label">Nome do Serviço</label>
        <input asp-for="Nome" class="form-control" />
    </div>

    <div class="mb-3">
        <label class="form-label">Descrição</label>
        <textarea asp-for="Descricao" class="form-control"></textarea>
    </div>

    <div class="mb-3">
        <label class="form-label">Preço</label>
        <input asp-for="Preco" type="number" step="0.01" class="form-control" />
    </div>

    <button type="submit" class="btn btn-success">
        Salvar
    </button>

    <a href="/Services" class="btn btn-secondary">
        Cancelar
    </a>

</form>