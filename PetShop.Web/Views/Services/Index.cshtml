@model List<PetShop.Web.Models.Servico>

@{
    ViewData["Title"] = "Serviços";
}

<div class="d-flex justify-content-between align-items-center mb-4">

    <h2>Serviços</h2>

    @if (Context.Session.GetString("Role") == "Admin")
    {
        <a href="/Services/Create" class="btn btn-primary">
            Novo Serviço
        </a>
    }

</div>

<table class="table table-hover">

    <thead>
        <tr>
            <th>Serviço</th>
            <th>Descrição</th>
            <th>Preço</th>

            @if (Context.Session.GetString("Role") == "Admin")
            {
                <th>Ações</th>
            }
        </tr>
    </thead>

    <tbody>

        @foreach (var servico in Model)
        {
            <tr>
                <td>@servico.Nome</td>

                <td>@servico.Descricao</td>

                <td>
                    R$ @servico.Preco.ToString("N2")
                </td>

                @if (Context.Session.GetString("Role") == "Admin")
                {
                    <td>
                        <a href="/Services/Edit/@servico.Id" class="btn btn-warning btn-sm">
                            Editar
                        </a>

                        <a href="/Services/Delete/@servico.Id" class="btn btn-danger btn-sm">
                            Excluir
                        </a>
                    </td>
                }
            </tr>
        }

    </tbody>

</table>