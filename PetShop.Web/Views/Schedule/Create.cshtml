@model PetShop.Web.Models.Reserva

@{
    ViewData["Title"] = "Novo Agendamento";
}

<h2 class="mb-4">Novo Agendamento</h2>

@if (ViewBag.Erro != null)
{
    <div class="alert alert-danger">
        @ViewBag.Erro
    </div>
}

<form method="post">

    <div class="mb-3">
        <label class="form-label">Pet</label>

        <select asp-for="PetId" class="form-select">

            @foreach (var pet in ViewBag.Pets)
            {
                <option value="@pet.Id">
                    @pet.Nome
                </option>
            }

        </select>
    </div>

    <div class="mb-3">
        <label class="form-label">Serviço</label>

        <select asp-for="Servico" class="form-select">

            @foreach (var servico in ViewBag.Servicos)
            {
                <option value="@servico.Nome">
                    @servico.Nome - R$ @servico.Preco.ToString("N2")
                </option>
            }

        </select>
    </div>

    <div class="mb-3">
        <label class="form-label">Data</label>

        <input asp-for="Data"
               type="date"
               class="form-control"
               id="dataInput" />
    </div>

    <div class="mb-3">
        <label class="form-label">Horário</label>

        <select asp-for="Horario"
                class="form-select"
                id="horarioSelect">

            @foreach (var horario in ViewBag.Horarios)
            {
                <option value="@horario">
                    @horario
                </option>
            }

        </select>
    </div>

    <button type="submit" class="btn btn-success">
        Agendar
    </button>

    <a href="/Schedule" class="btn btn-secondary">
        Cancelar
    </a>

</form>

<script>
document
    .getElementById("dataInput")
    .addEventListener("change", async function () {

        const data = this.value;

        const response =
            await fetch(`/Schedule/GetHorariosDisponiveis?data=${data}`);

        const horarios = await response.json();

        const select =
            document.getElementById("horarioSelect");

        select.innerHTML = "";

        horarios.forEach(horario => {

            const option =
                document.createElement("option");

            option.value = horario;

            option.text = horario;

            select.appendChild(option);

        });

    });
</script>