@model PetShop.Web.Models.Reserva

@{
    ViewData["Title"] = "Cancelar Agendamento";
}

<h2 class="text-danger mb-4">
    Cancelar Agendamento
</h2>

<div class="alert alert-warning">

    Deseja cancelar o agendamento do pet:

    <strong>@Model.Pet?.Nome</strong>?

</div>

<form method="post"
      action="/Schedule/ConfirmDelete/@Model.Id">

    <button type="submit"
            class="btn btn-danger">
        Confirmar Cancelamento
    </button>

    <a href="/Schedule"
       class="btn btn-secondary">
        Voltar
    </a>

</form>